#!/usr/bin/env bash
#
# 新しいマシンで最初に一度だけ流す。`yadm bootstrap` で呼ばれる。
#
# 設計:
#   - パッケージは「宣言」で持つ。macOS は ~/.Brewfile、Linux は下の apt 節。
#     以前は brew と apt に同じようなリストを二重に手書きしていた。
#   - **言語ランタイムとクロス OS の CLI は mise に寄せる**(~/.config/mise/
#     config.toml)。ここに書けば macOS でも Ubuntu でも同じものが入るので、
#     OS 別リストに足す理由が減る。
#   - 何度流しても安全(冪等)であること。壊れた環境の修復にも使うため。
#
# 2026-08-15: asdf を廃止し mise へ。以前ここは asdf v0.14.1 を git clone して
# いたが、それは .zshrc 側の移行と無言で食い違う類のもの。

set -euo pipefail

cd "$HOME"

log() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }

log 'submodules'
yadm submodule update --recursive --init

mkdir -p ~/bin ~/.local/bin

# --- OS ごとのパッケージ ----------------------------------------------------

case "$(uname)" in
Darwin)
  log 'bootstrap for macOS'
  if ! command -v brew >/dev/null 2>&1; then
    echo 'Homebrew がありません。https://brew.sh を先に入れてください。' >&2
    exit 1
  fi
  brew update
  # 中身は ~/.Brewfile(yadm 管理)。何を入れるかの決定はそちらが持つ。
  brew bundle --global
  ;;

Linux)
  log 'bootstrap for Linux'
  if command -v apt >/dev/null 2>&1; then
    # 何を入れるかの決定は ~/.config/apt/packages.txt が持つ(macOS 側の
    # ~/.Brewfile に対応する)。apt には Brewfile に相当する標準形式が無いので
    # 素のリストだが、得たいのは形式ではなく「宣言をスクリプトから分離する」性質。
    packages=$(sed 's/#.*//' ~/.config/apt/packages.txt | tr -s '[:space:]' '\n' | grep -v '^$')
    sudo apt update
    # shellcheck disable=SC2086
    sudo apt install -y $packages
  fi

  # フォント(Cica)。既に入っていれば何もしない。
  mkdir -p ~/.local/share/fonts
  if [ ! -e ~/.local/share/fonts/Cica-Regular.ttf ]; then
    log 'installing Cica font'
    (
      cd ~/.local/share/fonts
      curl -s https://api.github.com/repos/miiton/Cica/releases/latest |
        grep browser_download_url |
        grep -v _without_emoji.zip |
        head -n 1 |
        cut -d '"' -f 4 |
        wget -qi -
      unzip -o Cica_*.zip "*.ttf"
      rm -f Cica_*.zip
    )
  fi

  # macOS では brew が入れるもの。Linux では apt に無い/古いので個別に。
  if ! command -v starship >/dev/null 2>&1; then
    log 'installing starship'
    curl -fsSL https://starship.rs/install.sh | sh -s -- --yes
  fi
  if ! command -v mise >/dev/null 2>&1; then
    log 'installing mise'
    curl -fsSL https://mise.run | sh
  fi
  ;;
esac

# --- ランタイムとクロス OS の CLI -------------------------------------------

log 'mise tools'
export PATH="$HOME/.local/bin:$PATH"
if command -v mise >/dev/null 2>&1; then
  # ~/.config/mise/config.toml の [tools] を入れる。OS を跨いで同じ版が入る
  # のがここの利点で、apt と brew のリストを二重に保守しなくてよくなる。
  mise install
else
  echo 'mise が入りませんでした。手で入れてから再実行してください。' >&2
fi

# --- エディタ ---------------------------------------------------------------

if command -v vim >/dev/null 2>&1; then
  log 'vim plugins'
  # vim-plug 本体が無ければ取ってくる(以前は前提にしていた)。
  if [ ! -e ~/.vim/autoload/plug.vim ]; then
    curl -fsSLo ~/.vim/autoload/plug.vim --create-dirs \
      https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
  fi
  # `vim '+PlugUpdate' ... '+qall'` は **TTY が無いと永久に待つ**。
  # 2026-08-15 に Ubuntu コンテナで実測: vim が19分ハングして bootstrap が
  # 先へ進まなかった(プロビジョニング用のスクリプトとしては致命的で、
  # 手で流している限り気づけない類のもの)。
  #
  # 非対話で回す形は vim-plug が案内しているとおり `-es`(サイレント ex モード)
  # + `--sync`(完了までブロックする)。念のため timeout も噛ませる。
  timeout 600 vim -es -u ~/.vimrc -i NONE \
    -c 'PlugInstall --sync' -c 'PlugClean!' -c 'qa' </dev/null >/dev/null 2>&1 ||
    echo 'vim plugins: skipped or timed out (run :PlugInstall by hand)'
fi

# --- 仕上げ -----------------------------------------------------------------

cat <<'EOF'

bootstrap 完了。残りは手で:

  1. yadm config local.class personal   (仕事マシンなら work)
     -> そのあと yadm alt で ##class.* のファイルが展開される
  2. 新しいシェルを開く                 (mise の activation が入る)
  3. gh auth login / claude のログイン

EOF
